# Supabase (from Project Settings → API once the project exists)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test-mode keys to start — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# Webhook signing secret — from `stripe listen --forward-to localhost:3400/api/billing/webhook`
# locally, or the endpoint's signing secret once deployed.
STRIPE_WEBHOOK_SECRET=

# Used to build Stripe success/cancel redirect URLs when no request Origin header is present
# (e.g. server-to-server calls). Not required for normal browser checkout.
NEXT_PUBLIC_APP_URL=http://localhost:3400

# Automated engine (console.anthropic.com — separate billing from a Claude Code subscription).
# Powers discover_products/build_campaign job processing; every job costs real tokens.
ANTHROPIC_API_KEY=

# Shared secret checked by app/api/engine/run — must match the value stored in Supabase Vault
# as the "engine_webhook_secret" secret (set via execute_sql, see CLAUDE.md). Generate with:
#   openssl rand -hex 32
ENGINE_WEBHOOK_SECRET=

# Meta app credentials (developers.facebook.com — App Dashboard → Settings → Basic).
# Powers "Connect Facebook" OAuth + Page posting + real ad campaign launches (ads_management).
# Register ${NEXT_PUBLIC_APP_URL}/api/meta/callback as a valid OAuth redirect URI, and
# ${NEXT_PUBLIC_APP_URL}/api/meta/deauthorize as the Deauthorize Callback URL.
FB_CLIENT_ID=
FB_CLIENT_SECRET=

# Vercel Domains API — powers "Connect your own domain" (bring-your-own custom domains for
# presell/bridge pages, see app/(app)/domains). Create a Personal/Team Access Token at
# vercel.com/account/tokens with access to this project.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# Only needed if this Vercel project lives under a team (not a personal account).
VERCEL_TEAM_ID=
