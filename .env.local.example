# Supabase (from Project Settings → API once the project exists)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test-mode keys to start — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# Webhook signing secret — from `stripe listen --forward-to localhost:3400/api/billing/webhook`
# locally, or the endpoint's signing secret once deployed.
STRIPE_WEBHOOK_SECRET=

# Used to build Stripe success/cancel redirect URLs when no request Origin header is present
# (e.g. server-to-server calls). Not required for normal browser checkout.
NEXT_PUBLIC_APP_URL=http://localhost:3400

# Automated engine (console.anthropic.com — separate billing from a Claude Code subscription).
# Powers discover_products/build_campaign job processing; every job costs real tokens.
ANTHROPIC_API_KEY=

# Shared secret checked by app/api/engine/run — must match the value stored in Supabase Vault
# as the "engine_webhook_secret" secret (set via execute_sql, see CLAUDE.md). Generate with:
#   openssl rand -hex 32
ENGINE_WEBHOOK_SECRET=

# Meta app credentials (developers.facebook.com — App Dashboard → Settings → Basic).
# Powers "Connect Facebook" OAuth + Page posting + real ad campaign launches (ads_management) +
# Instagram posting (instagram_basic, instagram_content_publish).
# Register ${NEXT_PUBLIC_APP_URL}/api/meta/callback as a valid OAuth redirect URI, and
# ${NEXT_PUBLIC_APP_URL}/api/meta/deauthorize as the Deauthorize Callback URL.
FB_CLIENT_ID=
FB_CLIENT_SECRET=
# Only for apps on the "Facebook Login for Business" product (App Dashboard -> Facebook Login for
# Business -> Configurations). Not a secret — it travels as a query param in the login dialog URL.
# Leave blank on a classic "Facebook Login" app; the connect route then sends `scope` as before.
FB_LOGIN_CONFIG_ID=

# TikTok app credentials (developers.tiktok.com). Powers "Connect TikTok" + real video posting
# (video.publish). Unaudited apps must post as SELF_ONLY (private) — sufficient for testing on
# your own account; apply for "Direct Post" approval before a public rollout. Register
# ${NEXT_PUBLIC_APP_URL}/api/tiktok/callback as a valid redirect URI.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# (No Google OAuth client here any more. Gmail sending was retired first, then YouTube — both
# depended on Google scopes that need a security assessment for public rollout, which is the wrong
# dependency under a multi-tenant product. GEMINI_API_KEY below is a plain API key and unrelated.)

# kie.ai (kie.ai/api-key) — powers AI-generated Facebook/Instagram ad creative images.
KIE_AI_API_KEY=

# Cloudinary (console.cloudinary.com → Settings → API Keys) — image hosting and delivery.
# Images used to be base64 data: URIs inlined into every page; a blog index measured 4.1 MB with
# 98% of it one repeated image. Cloudinary serves them as real URLs with per-use resizing and
# format negotiation, which also lets them cache independently of the HTML.
#
# The cloud name is NEXT_PUBLIC_ because it is genuinely public — it appears in every delivery URL
# a browser loads — and because lib/images/validate.ts anchors its allowlist to it: a stored image
# URL is only accepted if it is on OUR cloud, which is what stops an image field becoming a way to
# hotlink or embed a tracking pixel. It is inlined at BUILD time, so changing it needs a rebuild.
# The key and secret are server-only and must never reach a client bundle.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google AI Studio (aistudio.google.com/apikey) — a plain API key, not an OAuth client. Powers direct Gemini API video generation (Veo), which in turn
# unlocks real TikTok/Instagram Reels posting.
GEMINI_API_KEY=

# Netlify domains (app.netlify.com → User settings → Applications → Personal access tokens) —
# powers "Connect your own domain". A tenant domain is attached as an alias on this Netlify site.
#
# Netlify has no per-domain API and no verification endpoint: aliases are set by PATCHing the site
# with the WHOLE list, and "is this domain pointing at us" is answered by resolving its DNS here.
# See lib/netlify/client.ts. Without these, tenants can still add domain rows; they just are not
# attached until the credentials exist.
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
# The site's own *.netlify.app hostname — what a tenant's SUBDOMAIN CNAMEs to. NEXT_PUBLIC_ because
# the setup instructions render in the browser, and it is the site's public address anyway.
NEXT_PUBLIC_NETLIFY_SITE_HOSTNAME=

# Per-organization subdomains ({workspace-slug}.affiliateoffersecrets.com). Both are NEXT_PUBLIC_*
# and inlined at BUILD time — changing either needs its own deployment to take effect (the same
# property that once kept the domain 404ing for a day after an env-only change).
# The bare root domain the wildcard hangs off. Unset locally: *.localhost already resolves in
# Chrome, so dev subdomain testing (acme.localhost:3400) needs no config at all.
NEXT_PUBLIC_ROOT_DOMAIN=
# Auth-cookie Domain attribute — ".affiliateoffersecrets.com" in production so one sign-in covers
# every subdomain. Setting it ALSO renames the session cookie (see lib/supabase/cookieOptions.ts),
# which deliberately signs everyone out once when first deployed. Leave unset in dev.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Stripe publishable key (pk_test_... / pk_live_...) — public by design, inlined into the client
# bundle. Required for the embedded card step on signup; without it that step is skipped, not broken.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# TikTok Ads (Marketing API) — a SEPARATE TikTok for Business app from TIKTOK_CLIENT_KEY above.
# That one is Login Kit (organic video posting); this one runs paid ads and is advertiser-scoped.
# app_id is numeric. Register ${NEXT_PUBLIC_APP_URL}/api/tiktok-ads/callback as the redirect URI.
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=
TIKTOK_ADS_REDIRECT_URI=
